{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RotMG Loot Roadmap",
  "version": "1.0.7",
  "identifier": "com.terrabyte.rotmg-loot-roadmap",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RotMG Loot Roadmap",
        "width": 1180,
        "height": 860,
        "minWidth": 680,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "backgroundColor": "#0a0c0f",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "useHttpsScheme": false,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com; form-action 'none'; frame-src 'none'; object-src 'none'; style-src-attr 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TerraByte",
    "shortDescription": "RotMG loot roadmap, kit planner and enchant browser.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEQTc4NDg1RTNGQTY2RTEKUldUaFp2cmpoWVNuZlZOKzl2eDVVcElCaVBDVDUyaElvMjByTUtqTTM4dTlCd092eHRER2NaOXIK",
      "endpoints": [
        "https://github.com/TerraByte-Dev/rotmg-loot-roadmap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}